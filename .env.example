# 复制为 .env 并按需修改。切勿提交真实 key 到仓库。
# API key 仅从环境变量/.env 读取，代码不硬编码。

# LLM Provider：mock（默认，离线测试）| ollama（本地）| siliconflow（云端）
LLM_PROVIDER=mock

# Ollama（本地 qwen3:8b，需先启动 ollama serve 并拉取模型）
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:8b

# SiliconFlow（通义千问等，OpenAI 兼容）
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
SILICONFLOW_MODEL=Qwen/Qwen3-8B
# SILICONFLOW_API_KEY=sk-xxxxxxxx   # 真实 key 放这里或系统环境变量

# 输出目录
OUTPUT_DIR=output
DEFAULT_LANGUAGE=zh
